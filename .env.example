# Browser-safe Supabase credentials (the anon key is protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# Transactional email
RESEND_API_KEY=re_your_key
EMAIL_FROM=Go Team Go <no-reply@your-domain.com>

# Public application URL
APP_URL=http://localhost:3000

# Upload limits in megabytes
VITE_MAX_PHOTO_SIZE_MB=10
VITE_MAX_DOCUMENT_SIZE_MB=25
VITE_MAX_VIDEO_SIZE_MB=500
